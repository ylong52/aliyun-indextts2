# 应用配置
APP_NAME=python-indextts
APP_PORT=8000
APP_DEBUG=false
APP_WORKERS=4

# Python配置
PYTHON_VERSION=3.9
PYTHONPATH=/app:/opt/python/shared/packages

# 虚拟环境
VENV_PATH=/opt/venv/app
EXTERNAL_PACKAGES=/opt/python/shared/packages
EXTERNAL_CACHE=/opt/python/shared/cache

# 镜像配置
IMAGE_NAME=python-indextts
TAG=latest
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn

# 资源限制
CPU_LIMIT=1.0
MEMORY_LIMIT=512M
CPU_RESERVATION=0.5
MEMORY_RESERVATION=256M
